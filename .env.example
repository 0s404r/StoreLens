# =============================================================================
# Supabase (Database + Auth)
# Get these from https://app.supabase.com → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Claude API (Anthropic) — For qualitative UX analysis
# Get from https://console.anthropic.com → API Keys
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# =============================================================================
# Google PageSpeed Insights API — For performance audits
# Get from https://console.cloud.google.com → enable PageSpeed Insights API
# =============================================================================
PAGESPEED_API_KEY=your-pagespeed-api-key

# =============================================================================
# Screenshot service — Choose one
# Option A: ScreenshotOne (recommended for simplicity)
#   Get from https://screenshotone.com → Dashboard → Access Keys
# =============================================================================
SCREENSHOTONE_ACCESS_KEY=your-screenshotone-key

# =============================================================================
# Lemon Squeezy (Payments) — For paid scans and credit packs
# Get from https://app.lemonsqueezy.com → Settings → API
# =============================================================================
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMONSQUEEZY_VARIANT_SINGLE=variant-id-for-2dollar-single-scan
LEMONSQUEEZY_VARIANT_PACK_10=variant-id-for-15dollar-10pack

# =============================================================================
# WhatsApp — Your team's number for "صلحوهالي" CTA
# Format: country code + number, no +, no spaces. E.g., 201234567890
# =============================================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=201234567890
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=أنا عاوز أعمل audit لستوري وأشتغل على التحسينات

# =============================================================================
# App config
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=StoreLens
